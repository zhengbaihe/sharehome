# Local development placeholders only; replace before any deployment.
POSTGRES_USER=sharehome_dev
POSTGRES_PASSWORD=replace_me_local_only
POSTGRES_DB=sharehome_dev
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173
APP_NAME=ShareHome
ENVIRONMENT=development
# Host-side backend. Compose builds its own URL using the db service hostname.
DATABASE_URL=postgresql+psycopg://sharehome_dev:replace_me_local_only@localhost:5432/sharehome_dev

# Placeholder only. Replace with a randomly generated secret of at least 32 bytes.
# Required for token helpers; never use this example secret in production.
JWT_SECRET=replace_me_with_a_random_secret_at_least_32_bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
